    "keywords": ["beer", "quiz", "questionnaire", "decision tree"],
    "attributes": {
        "treeId": { "type": "integer", "default": 0 }
    },
    "supports": { "html": false },
    "editorScript": "file:./index.js",
    "viewScript": "file:./view.js",
    "style": "file:./style.css"
}
